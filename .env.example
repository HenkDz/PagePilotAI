# Build-time defaults for PagePilot AI
#
# WXT uses Vite under the hood, so variables prefixed with VITE_ are exposed to the client at build time.
# These values are optional and primarily support local development. Credentials are stored per-user inside the extension UI.

# Base URL for the OpenAI-compatible API (e.g., https://api.openai.com/v1)
VITE_PAGEPILOT_AI_BASE_URL=https://openrouter.ai/api/v1

# Default model identifier to display when users configure AI settings
VITE_PAGEPILOT_AI_MODEL=openai/gpt-5.1-codex-max
VITE_PAGEPILOT_API=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
